# Supabase project (local dev defaults shown; get cloud values from the Supabase dashboard)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Origin used inside generated QR codes (must be the deployed app origin).
# PERMANENT once real tags are printed — QR codes encode it forever.
VITE_APP_ORIGIN=https://specimap.org

# Optional: raster tile provider template (defaults to OSM; respect usage policies)
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
